# Copy the lines you need into your shell or a .env loader. Every setting has a default.

PORT=8080
HF_DB=data/holdfast.db
HF_OLLAMA_URL=http://localhost:11434
HF_MODEL=gemma3:4b            # gemma3:1b on Render's small instance
HF_MODEL_TIMEOUT=90s
HF_MODEL_THREADS=0            # 0 lets Ollama choose
HF_TIMEZONE=Asia/Kolkata      # times in client notes
HF_RETENTION=72h              # events older than this are deleted
HF_DEMO=true                  # the Chai & Co. demo shop and buttons

# Password for private routes' pages (any user name). Leave empty to hide private routes.
HF_ADMIN_TOKEN=

# Real routes. Providers send to /in/<name>. Keep secrets out of the repo.
# HF_ROUTES=[{"name":"my-repo","source":"github","secret":"…","destination":"https://example.com/hooks/github","client":"Me"}]
HF_ROUTES=

# Live mode (sign in with GitHub). Create an OAuth app at github.com/settings/developers with the
# callback URL <public URL>/auth/github/callback.
HF_GITHUB_CLIENT_ID=
HF_GITHUB_CLIENT_SECRET=
HF_SESSION_KEY=               # any long random string; keeps sign-ins and stored tokens across restarts
HF_PUBLIC_URL=                # defaults to Render's RENDER_EXTERNAL_URL, else the request's host
HF_MAX_CONNECTIONS=5          # per user
HF_DEV_LOGIN=false            # local development only: simulated GitHub, no real webhooks
